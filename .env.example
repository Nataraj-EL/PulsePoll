# Root Environment Variables Example
PORT=8080

# MongoDB Connection String: Local or Atlas SRV format
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<db_username>:<db_password>@cluster0.lw2wa9r.mongodb.net/?appName=Cluster0
MONGO_URI=mongodb://localhost:27017
MONGO_DB=pulsepoll

# Redis Connection: Local TCP or Upstash Cloud Native TCP (rediss://)
# Local: REDIS_ADDR=localhost:6379
# Upstash Native TCP: REDIS_URL=rediss://default:<upstash_password>@teaching-orca-282483.upstash.io:6379
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
# REDIS_URL=rediss://default:<upstash_password>@teaching-orca-282483.upstash.io:6379

CORS_ORIGIN=http://localhost:5173
ENVIRONMENT=development

# Resend Email Service (Welcome Emails)
RESEND_API_KEY=re_123456789_example
